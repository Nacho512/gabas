% =============================================================
% SECOND OPTIONAL ARGUMENT: LETS THE USER REGISTER ANY EXTRA CUSTOM FOLDER
% PATH[S] [E.G. A FOLDER OUTSIDE THE HARDCODED CHAPTER NAMING PATTERN, LIKE
% A DIFFERENT PROJECT'S IMAGE FOLDER] ON TOP OF THE AUTOMATIC CHAPTER FOLDERS
% ABOVE. PASS ONE OR MORE PATHS, SEPARATED BY COMMAS. EACH PATH MUST:
%  - USE FORWARD SLASHES "/" [EVEN ON WINDOWS: "C:/Users/..." NOT "C:\Users\..."]
%  - END WITH A TRAILING "/"
% USAGE: \RegisterChapterPaths[10][C:/Users/Dell/Desktop/PROGRAMMING-7/LUA-FOARTE/GABAS_LINAL/]
\NewDocumentCommand{\RegisterChapterPaths}{O{10} O{}}
{
  \seq_clear:N \l_auto_paths_seq
  
% ROOT DIRECTORY.
  \seq_put_right:Nn \l_auto_paths_seq { ./ }
  
  
% THIS IS A MINDBLOWING AND VERY INSANE KIND OF CRAZY CONTROL STRUCTURE TO DEFINE THE NAMES OF THE IMAGE SOURCE FOLDERS UP TO 9, I THINK [THE -1 THING IS SOMETHING I COPIED FROM SOMEONE ELSE'S CODE AND I DON'T KNOW WHAT IT MEANS OR DOES IN THIS STRUCTURE. [LATEX CONTINUES TO BAFFLE ME.]
  
  \int_compare:nTF { #1 < 10 }
    {
      \int_step_inline:nnn { 1 } { #1 } {
        \seq_put_right:Nn \l_auto_paths_seq { ./CHAPTER0##1-PRACTICE-PROBLEMS-IMAGES/ }
        \seq_put_right:Nn \l_auto_paths_seq { ./CHAPTER0##1-EXERCISES-IMAGES/ }
      }
    }
    {
      \int_step_inline:nnn { 1 } { 9 } {
        \seq_put_right:Nn \l_auto_paths_seq { ./CHAPTER0##1-PRACTICE-PROBLEMS-IMAGES/ }
        \seq_put_right:Nn \l_auto_paths_seq { ./CHAPTER0##1-EXERCISES-IMAGES/ }
      }
      
      \int_step_inline:nnn { 10 } { #1 } {
        \int_compare:nTF { ##1 < 10 }
          {
            \seq_put_right:Nn \l_auto_paths_seq { ./CHAPTER0##1-PRACTICE-PROBLEMS-IMAGES/ }
            \seq_put_right:Nn \l_auto_paths_seq { ./CHAPTER0##1-EXERCISES-IMAGES/ }
          }
          {
            \seq_put_right:Nn \l_auto_paths_seq { ./CHAPTER##1-PRACTICE-PROBLEMS-IMAGES/ }
            \seq_put_right:Nn \l_auto_paths_seq { ./CHAPTER##1-EXERCISES-IMAGES/ }
          }
      }
    } % DO YOU THINK THERE IS A BETTER AND MORE ORDERED WAY I MIGHT WORK WITH THE CURLY BRACKETS? THEY ARE NESTED AND ARE A SOURCE OF HORRIBLE LOGICAL ERRORS JUST AS IN JAVA OR IN C.

  % REGISTRATION OF THE USER'S CUSTOM EXTRA PATH[S], IF ANY WERE PROVIDED.
  \tl_if_empty:nF { #2 } {
    \seq_clear:N \l_gabas_extra_paths_seq
    \seq_set_split:Nnn \l_gabas_extra_paths_seq { , } { #2 }
    \seq_map_inline:Nn \l_gabas_extra_paths_seq {
      \tl_set:Nn \l_gabas_tmp_path_tl { ##1 }
      \tl_trim_spaces:N \l_gabas_tmp_path_tl
      \tl_if_empty:NF \l_gabas_tmp_path_tl {
        \seq_put_right:NV \l_auto_paths_seq \l_gabas_tmp_path_tl
      }
    }
  }

  \exp_args:NV \graphicspath \l_auto_paths_seq
}

