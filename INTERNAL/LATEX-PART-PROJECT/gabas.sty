% - Usage: \InsertImages*{iMG1.png, GABATON.jpg, KRAKEN.pdf}{draft=F, size={width;heiight;T}, columns=2, numbering=F, captions= {[''CAPTION1''];[''CAPTION2];[''CAPTION3'']; ;[''CAPTION5']}, pdfpages = {9,3;7,2,5;613}}
